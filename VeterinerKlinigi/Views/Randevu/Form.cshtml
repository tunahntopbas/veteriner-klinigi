@*
    ÖDEV 4.1 — Randevu alma, ADIM ADIM: 1) hayvan → 2) hizmet → 3) gün → 4) hekim ve saat.
    (Numaralar gerçek bir sıra olduğu için var; her adım bir öncekine bağlı.)

    25.11 YENİ GÖRÜNÜM:
      - Hayvan ve hizmet açılır liste yerine kartla seçilir (radio düğmeleri; form alan adları AYNI:
        EvcilHayvanId, HizmetId → POST tarafı ve testler değişmedi).
      - Gün: önümüzdeki 14 günün şeridi; klinik kapalı günler pasif (çalışma saatleri veritabanından).
        Daha ileri bir tarih için altta takvim alanı da var.
      - Saat: her hekim için boş saat ızgarası, sabah ve öğleden sonra ayrı.
      - Sağda canlı özet: seçilen her şey, süre, ücret ve "Randevu talebi gönder".

    REST API NEREDE TÜKETİLİYOR? (sunum sorusu) — TAM BURADA:
      Hizmet veya gün değişince jQuery, GET /api/veterinerler/uygun?hizmetId=..&tarih=..
      ucunu çağırır. Gelen JSON'daki her hekim için boş saat düğmeleri çizilir.
      Kullanıcı bir saate tıklayınca VeterinerId ve Saat GİZLİ alanlara yazılır, form normal POST ile gider.

    ÖDEV 4.2 — Liste zaten sadece uygun saatleri gösterir; yine de sunucu kaydetmeden önce
    tüm kuralları tekrar kontrol eder ve sorun varsa formun üstünde nedenini yazar.
*@
@model RandevuFormVM
@inject IKlinikServisi KlinikServisi
@{
    var ekleme = Model.Id == 0;
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var klinik = await KlinikServisi.GetirAsync();
    var bugun = DateOnly.FromDateTime(DateTime.Today);
    bool AcikMi(DateOnly g) => klinik.CalismaSaatleri.Any(c => c.Gun == g.DayOfWeek && !c.Kapali);
    var gunler = Enumerable.Range(0, 14).Select(i => bugun.AddDays(i)).ToList();
    var seciliHizmet = Model.HizmetListesi.FirstOrDefault(h => h.Id == Model.HizmetId);
    var seciliHayvan = Model.Hayvanlar.FirstOrDefault(h => h.Id == Model.EvcilHayvanId);
}

<a asp-action="Index" class="geri-baglanti">Randevularım</a>
<div class="sayfa-basi">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="sayfa-alt">Dört adımda: hayvan, hizmet, gün, saat. Yalnızca gerçekten boş olan saatler listelenir.</p>
    </div>
</div>

<form asp-action="@(ekleme ? "Olustur" : "Duzenle")" asp-route-id="@(ekleme ? null : Model.Id)" method="post" id="randevuFormu">
    @* ModelOnly: alan hataları kendi adımının altında görünür; burada yalnızca sunucunun iş kuralı
       uyarıları (ör. "Elif Kaya 10:00–10:30 arası başka bir randevuda") çıkar. *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Id" />

    <div class="randevu-duzeni">
        <div class="adim-listesi">

            @* ---------- 1) HAYVAN ---------- *@
            <fieldset class="adim-kutusu" id="adim1">
                <legend><span class="adim-no">1</span>Hangi hayvanınız için?</legend>
                <div class="secim-izgarasi hayvanlar">
                    @foreach (var h in Model.Hayvanlar)
                    {
                        <label class="secim-karti">
                            <input type="radio" asp-for="EvcilHayvanId" value="@h.Id" data-ad="@h.Ad" />
                            <span class="secim-avatar">
                                @if (h.FotografDosyaAdi is not null)
                                {
                                    <img src="@Url.Action("Fotograf", "EvcilHayvan", new { id = h.Id })" alt="" loading="lazy" />
                                }
                                else
                                {
                                    @h.Ad[..1]
                                }
                            </span>
                            <span class="secim-metin"><strong>@h.Ad</strong><small>@h.Tur</small></span>
                        </label>
                    }
                </div>
                <span asp-validation-for="EvcilHayvanId" class="text-danger small"></span>
            </fieldset>

            @* ---------- 2) HİZMET ---------- *@
            <fieldset class="adim-kutusu" id="adim2">
                <legend><span class="adim-no">2</span>Hangi hizmet?</legend>
                <div class="secim-izgarasi hizmetler">
                    @foreach (var h in Model.HizmetListesi)
                    {
                        <label class="secim-karti hizmet">
                            <input type="radio" asp-for="HizmetId" value="@h.Id" data-ad="@h.Ad" data-sure="@h.SureDakika" data-ucret="@h.Ucret.ToString("N0", tr)" />
                            <span class="secim-metin"><strong>@h.Ad</strong><small>@h.SureDakika dakika</small></span>
                            <span class="secim-ucret veri">@h.Ucret.ToString("N0", tr) TL</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="HizmetId" class="text-danger small"></span>
            </fieldset>

            @* ---------- 3) GÜN ---------- *@
            <fieldset class="adim-kutusu" id="adim3">
                <legend><span class="adim-no">3</span>Hangi gün?</legend>
                <div class="gun-seridi" role="group" aria-label="Önümüzdeki 14 gün">
                    @foreach (var g in gunler)
                    {
                        var acik = AcikMi(g);
                        <button type="button" class="gun-dugmesi" data-tarih="@g.ToString("yyyy-MM-dd")"
                                aria-pressed="@(g == Model.Tarih ? "true" : "false")" disabled="@(!acik)"
                                title="@(acik ? g.ToString("d MMMM dddd", tr) : "Klinik kapalı")">
                            <span class="gd-gun">@(g == bugun ? "Bugün" : g.ToString("ddd", tr))</span>
                            <span class="gd-sayi veri">@g.Day</span>
                            <span class="gd-ay">@g.ToString("MMM", tr)</span>
                        </button>
                    }
                </div>
                <div class="diger-tarih">
                    <label asp-for="Tarih" class="form-label small text-body-secondary mb-1">Daha ileri bir tarih</label>
                    <input asp-for="Tarih" type="date" class="form-control form-control-sm" min="@bugun.ToString("yyyy-MM-dd")" />
                </div>
            </fieldset>

            @* ---------- 4) HEKİM VE SAAT (REST API) ---------- *@
            <fieldset class="adim-kutusu" id="adim4">
                <legend><span class="adim-no">4</span>Hekim ve saat</legend>
                <div id="uygunHekimler" aria-live="polite"><p class="text-body-secondary mb-0">Hizmet ve gün seçin.</p></div>
                @* jQuery'nin dolduracağı gizli alanlar *@
                <input type="hidden" asp-for="VeterinerId" />
                <input type="hidden" asp-for="Saat" />
                <span asp-validation-for="VeterinerId" class="text-danger small"></span>
            </fieldset>

            <div class="adim-kutusu not-kutusu">
                <label asp-for="SahipNotu" class="form-label"></label>
                <textarea asp-for="SahipNotu" class="form-control" rows="2" placeholder="Örn. iki gündür iştahsız"></textarea>
                <span asp-validation-for="SahipNotu" class="text-danger small"></span>
            </div>
        </div>

        @* ---------- Canlı özet ---------- *@
        <aside class="randevu-ozeti" aria-labelledby="ozetBaslik">
            <h2 id="ozetBaslik" class="kart-etiket">Randevu özeti</h2>
            <dl>
                <div><dt>Hayvan</dt><dd id="ozHayvan">@(seciliHayvan?.Ad ?? "—")</dd></div>
                <div><dt>Hizmet</dt><dd id="ozHizmet">@(seciliHizmet?.Ad ?? "—")</dd></div>
                <div><dt>Gün</dt><dd id="ozGun">—</dd></div>
                <div><dt>Hekim ve saat</dt><dd id="ozSaat">—</dd></div>
            </dl>
            <div class="ozet-tutar">
                <span>Süre <strong class="veri" id="ozSure">@(seciliHizmet is null ? "—" : $"{seciliHizmet.SureDakika} dk")</strong></span>
                <span>Ücret <strong class="veri" id="ozUcret">@(seciliHizmet is null ? "—" : $"{seciliHizmet.Ucret.ToString("N0", tr)} TL")</strong></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100" id="gonderDugmesi">@(ekleme ? "Randevu talebi gönder" : "Değişikliği kaydet")</button>
            <p class="ozet-not">Talebiniz "Bekliyor" durumunda oluşur; hekim ya da klinik onaylayınca kesinleşir.</p>
            <a asp-action="Index" class="ozet-vazgec">Vazgeç</a>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function guvenli(m) { return $('<div>').text(m ?? '').html(); }
        var tarihBicimi = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', weekday: 'long' });

        // Düzenleme ekranında / hızlı randevu kartından gelindiğinde mevcut seçim (sunucudan gelen değerler)
        var seciliHekim = '@Model.VeterinerId';
        var seciliSaat = '@(Model.Saat?.ToString("HH:mm") ?? "")';
        var seciliHekimAd = '';

        // ------------------------------------------------------------------
        // Özet kartı ve adımların "tamam" işareti
        // ------------------------------------------------------------------
        function ozetiGuncelle() {
            var hayvan = $('input[name=EvcilHayvanId]:checked'), hizmet = $('input[name=HizmetId]:checked'), tarih = $('#Tarih').val();
            $('#ozHayvan').text(hayvan.data('ad') || '—');
            $('#ozHizmet').text(hizmet.data('ad') || '—');
            $('#ozSure').text(hizmet.length ? hizmet.data('sure') + ' dk' : '—');
            $('#ozUcret').text(hizmet.length ? hizmet.data('ucret') + ' TL' : '—');
            $('#ozGun').text(tarih ? tarihBicimi.format(new Date(tarih + 'T00:00:00')) : '—');
            $('#ozSaat').text(seciliSaat && seciliHekimAd ? seciliHekimAd + ', ' + seciliSaat : '—');
            $('#adim1').toggleClass('tamam', hayvan.length > 0);
            $('#adim2').toggleClass('tamam', hizmet.length > 0);
            $('#adim3').toggleClass('tamam', !!tarih);
            $('#adim4').toggleClass('tamam', !!seciliSaat && seciliHekim !== '0' && seciliHekim !== '');
        }

        // ------------------------------------------------------------------
        // ADIM 4 — REST API ÇAĞRISI: uygun hekimler ve boş saatleri
        // ------------------------------------------------------------------
        function uygunlariGetir() {
            var hizmetId = $('input[name=HizmetId]:checked').val();
            var tarih = $('#Tarih').val();
            var kutu = $('#uygunHekimler');
            if (!hizmetId || !tarih) {
                kutu.html('<p class="text-body-secondary mb-0">Hizmet ve gün seçin.</p>');
                return;
            }
            kutu.addClass('yukleniyor');

            $.getJSON('/api/veterinerler/uygun', { hizmetId: hizmetId, tarih: tarih })
                .done(function (hekimler) {          // 200 → UygunHekimDto[]
                    kutu.empty();
                    var dolu = hekimler.filter(function (h) { return h.bosSaatler.length > 0; });
                    if (dolu.length === 0) {
                        kutu.html('<p class="bos-saat-yok">Bu gün bu hizmet için boş saat yok (klinik kapalı ya da hekimler dolu). Başka bir gün seçin.</p>');
                        return;
                    }
                    var sira = 0;
                    $.each(dolu, function (_, h) {
                        // Sabah (13:00'ten önce) ve öğleden sonra ayrı satırlar
                        function dugmeler(liste) {
                            return $.map(liste, function (s) {
                                var secili = String(h.veterinerId) === seciliHekim && s === seciliSaat;
                                if (secili) seciliHekimAd = h.adSoyad;
                                return '<button type="button" class="saat-dugmesi yeni" style="--i:' + (sira++) + '" aria-pressed="' + secili +
                                    '" data-hekim="' + h.veterinerId + '" data-hekim-ad="' + guvenli(h.adSoyad) + '" data-saat="' + s + '">' + s + '</button>';
                            }).join('');
                        }
                        var sabah = h.bosSaatler.filter(function (s) { return s < '13:00'; });
                        var ogle = h.bosSaatler.filter(function (s) { return s >= '13:00'; });
                        var satirlar = '';
                        if (sabah.length) satirlar += '<div class="saat-satiri"><span class="saat-etiketi">Sabah</span><div class="saat-izgarasi">' + dugmeler(sabah) + '</div></div>';
                        if (ogle.length) satirlar += '<div class="saat-satiri"><span class="saat-etiketi">Öğleden sonra</span><div class="saat-izgarasi">' + dugmeler(ogle) + '</div></div>';
                        kutu.append('<div class="hekim-saatleri"><div class="hs-ust"><strong>' + guvenli(h.unvan) + ' ' + guvenli(h.adSoyad) +
                            '</strong><span>' + $.map(h.uzmanliklar, guvenli).join(', ') + '</span></div>' + satirlar + '</div>');
                    });
                    ozetiGuncelle();
                })
                .fail(function (xhr) {                // 400 / 404 → HataDto { hata }
                    var mesaj = (xhr.responseJSON && xhr.responseJSON.hata) || 'Uygun saatler alınamadı.';
                    kutu.html('<div class="alert alert-danger mb-0">' + guvenli(mesaj) + '</div>');
                })
                .always(function () { kutu.removeClass('yukleniyor'); });
        }

        function secimiTemizle() {
            seciliHekim = ''; seciliSaat = ''; seciliHekimAd = '';
            $('#VeterinerId').val('0'); $('#Saat').val('');
        }

        // Saat düğmesi → seçimi gizli alanlara yaz
        $('#uygunHekimler').on('click', '.saat-dugmesi', function () {
            $('.saat-dugmesi').attr('aria-pressed', 'false');
            $(this).attr('aria-pressed', 'true');
            seciliHekim = String($(this).data('hekim'));
            seciliSaat = $(this).data('saat');
            seciliHekimAd = $(this).data('hekim-ad');
            $('#VeterinerId').val(seciliHekim);
            $('#Saat').val(seciliSaat);
            $('#VeterinerId').valid && $('#VeterinerId').valid();
            ozetiGuncelle();
        });

        // Gün şeridi → tarih alanına yaz
        $('.gun-seridi').on('click', '.gun-dugmesi', function () {
            $('.gun-dugmesi').attr('aria-pressed', 'false');
            $(this).attr('aria-pressed', 'true');
            $('#Tarih').val($(this).data('tarih')).trigger('change');
        });
        // Takvimden ileri tarih seçilirse şeritte eşleşen gün varsa onu işaretle
        $('#Tarih').on('change', function () {
            var t = $(this).val();
            $('.gun-dugmesi').each(function () { $(this).attr('aria-pressed', String($(this).data('tarih') === t)); });
        });

        // Hayvan değişince sadece özet; hizmet veya gün değişince eski saat geçersiz → temizle ve yeniden sorgula
        $('input[name=EvcilHayvanId]').on('change', ozetiGuncelle);
        $('input[name=HizmetId], #Tarih').on('change', function () {
            secimiTemizle();
            uygunlariGetir();
            ozetiGuncelle();
        });

        // Gizli alanlar da doğrulansın (jquery.validate varsayılan olarak gizli alanları atlar).
        $.validator.setDefaults({ ignore: [] });

        // Tek hayvan varsa onu seç
        if ($('input[name=EvcilHayvanId]').length === 1 && !$('input[name=EvcilHayvanId]:checked').length)
            $('input[name=EvcilHayvanId]').prop('checked', true);
        ozetiGuncelle();
        uygunlariGetir();
    </script>
}
