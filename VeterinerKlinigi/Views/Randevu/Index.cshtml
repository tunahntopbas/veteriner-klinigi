@* Üyenin randevuları (servis sorgusu yalnızca kendi hayvanlarının randevularını döner). *@
@model List<Randevu>

<div class="sayfa-basi">
    <div>
        <h1>Randevularım</h1>
        <p class="sayfa-alt">@Model.Count randevu</p>
    </div>
    <a asp-action="Olustur" class="btn btn-primary">Randevu al</a>
</div>

<partial name="_RandevuTablosu" model="Model" />
