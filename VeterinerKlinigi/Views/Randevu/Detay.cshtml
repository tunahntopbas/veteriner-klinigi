@* ÖDEV 4.3 — Randevu detayları + sahibin yapabilecekleri (değiştir / iptal). *@
@model Randevu

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Randevu #@Model.Id</h1>
    <a asp-action="Index" class="btn btn-link">← Randevularım</a>
</div>

<div class="row g-4">
    <div class="col-lg-8"><partial name="_RandevuBilgileri" model="Model" /></div>
    <div class="col-lg-4">
        <div class="card kart-golge">
            <div class="card-body d-grid gap-2">
                @if (Model.Durum == RandevuDurumu.Bekliyor)
                {
                    <p class="small text-muted mb-1">Randevunuz klinik onayı bekliyor. Onaylanana kadar değiştirebilirsiniz.</p>
                    <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-outline-primary">Değiştir</a>
                }
                @if (RandevuServisi.GecisGecerliMi(Model.Durum, RandevuDurumu.IptalEdildi) && Model.BaslangicZamani > DateTime.Now)
                {
                    <form asp-action="Iptal" asp-route-id="@Model.Id" method="post" class="d-grid" onsubmit="return confirm('Randevunuz iptal edilsin mi?');">
                        <button type="submit" class="btn btn-outline-danger">İptal et</button>
                    </form>
                }
                <a asp-controller="EvcilHayvan" asp-action="Detay" asp-route-id="@Model.EvcilHayvanId" class="btn btn-link">@Model.EvcilHayvan?.Ad sayfasına git</a>
            </div>
        </div>
    </div>
</div>
