@*
    ÖDEV Beklenen-Kayit — Üye olma sayfası.
    ÖDEV Beklenen-Validation — asp-for / asp-validation-for Tag Helper'ları:
      - input'a name, id, value ve data-val-* attribute'lerini üretir
      - data-val-* attribute'lerini jquery.validate okur → İSTEMCİ tarafı doğrulama
      - Sunucu tarafında aynı kurallar ModelState ile tekrar kontrol edilir
*@
@model KayitVM

<div class="hesap-kutusu">
    <div>
        <div class="panel">
            <div class="card-body p-4">
                <h1>Üye ol</h1>
                <p class="sayfa-alt mb-4">Hayvanınızı ekleyip randevu almak için bir hesap oluşturun.</p>

                <form asp-action="Kayit" method="post">
                    @* ModelOnly: alana bağlı olmayan hatalar (ör. "bu e-posta kullanılıyor") *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="AdSoyad" class="form-label"></label>
                        <input asp-for="AdSoyad" class="form-control" autocomplete="name" />
                        <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Eposta" class="form-label"></label>
                        <input asp-for="Eposta" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Eposta" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Telefon" class="form-label"></label>
                        <input asp-for="Telefon" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Telefon" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label"></label>
                        <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                        <div class="form-text">En az 6 karakter; büyük harf, küçük harf, rakam ve sembol içermeli.</div>
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SifreTekrar" class="form-label"></label>
                        <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Üye Ol</button>
                </form>

                <p class="hesap-alt">
                    Zaten üye misiniz? <a asp-action="Giris">Giriş yapın</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* İstemci tarafı doğrulama betikleri (jquery.validate + unobtrusive) *@
    <partial name="_ValidationScriptsPartial" />
}
