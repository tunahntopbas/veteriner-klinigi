@*
    PARTIAL VIEW — ÖDEV 4.3: randevunun saklanan tüm detayları
    (hizmet, süre, ücret, hekim, hayvan, tarih/saat) + durum + muayene notu.
    Üç rolün detay sayfası da bunu kullanır.
*@
@model Randevu

<div class="card kart-golge mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Durum</dt><dd class="col-sm-8"><partial name="_DurumRozeti" model="Model.Durum" /></dd>
            <dt class="col-sm-4">Tarih / saat</dt>
            <dd class="col-sm-8">@Model.BaslangicZamani.ToString("dd.MM.yyyy dddd") · <strong>@Model.BaslangicZamani.ToString("HH:mm") – @Model.BitisZamani.ToString("HH:mm")</strong></dd>
            <dt class="col-sm-4">Hayvan</dt><dd class="col-sm-8">@Model.EvcilHayvan?.Ad (@Model.EvcilHayvan?.Tur@(Model.EvcilHayvan?.Irk is null ? "" : ", " + Model.EvcilHayvan.Irk))</dd>
            <dt class="col-sm-4">Sahibi</dt><dd class="col-sm-8">@Model.EvcilHayvan?.Sahip?.AdSoyad</dd>
            <dt class="col-sm-4">Hizmet</dt><dd class="col-sm-8">@Model.Hizmet?.Ad</dd>
            <dt class="col-sm-4">Süre</dt><dd class="col-sm-8">@Model.SureDakika dakika</dd>
            <dt class="col-sm-4">Ücret</dt><dd class="col-sm-8">@Model.Ucret.ToString("N2", new System.Globalization.CultureInfo("tr-TR")) TL</dd>
            <dt class="col-sm-4">Hekim</dt><dd class="col-sm-8">@Model.Veteriner?.Unvan @Model.Veteriner?.AdSoyad</dd>
            <dt class="col-sm-4">Sahibin notu</dt><dd class="col-sm-8">@(Model.SahipNotu ?? "—")</dd>
            @if (Model.Durum == RandevuDurumu.Reddedildi)
            {
                <dt class="col-sm-4">Red nedeni</dt>
                <dd class="col-sm-8">@(Model.RedNedeni ?? "—")</dd>
            }
            <dt class="col-sm-4">Oluşturulma</dt><dd class="col-sm-8 text-muted">@Model.OlusturmaZamani.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

@if (Model.MuayeneNotu is { } not)
{
    @* ÖDEV 3.4 — Tamamlanan randevunun muayene notu *@
    <div class="card kart-golge mb-3 border-success">
        <div class="card-header">Muayene notu <small class="text-muted">(@not.YazilmaZamani.ToString("dd.MM.yyyy HH:mm"))</small></div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Teşhis</dt><dd class="col-sm-8">@(not.Teshis ?? "—")</dd>
                <dt class="col-sm-4">Tedavi</dt><dd class="col-sm-8">@(not.Tedavi ?? "—")</dd>
                <dt class="col-sm-4">Notlar</dt><dd class="col-sm-8" style="white-space:pre-line">@not.Notlar</dd>
            </dl>
        </div>
    </div>
}
