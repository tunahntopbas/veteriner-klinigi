@*
    PARTIAL VIEW — randevu durumunu renkli rozet olarak gösterir.
    Üye, hekim ve admin sayfalarında aynı rozet kullanılır → tek dosya.
    Kullanım: <partial name="_DurumRozeti" model="r.Durum" />
    Renkler site.css'teki --durum-* token'larından gelir (koyu zeminde okunur kontrast).
*@
@model RandevuDurumu
@{
    var sinif = Model switch
    {
        RandevuDurumu.Bekliyor => "durum-bekliyor",
        RandevuDurumu.Onaylandi => "durum-onaylandi",
        RandevuDurumu.Tamamlandi => "durum-tamamlandi",
        RandevuDurumu.Reddedildi => "durum-reddedildi",
        _ => "durum-iptal"
    };
}
<span class="durum @sinif">@RandevuServisi.DurumAdi(Model)</span>
