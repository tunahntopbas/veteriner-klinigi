@*
    PARTIAL VIEW — evcil hayvan kartı. Veriyi kendisi getirmez; çağıran ne verirse onu gösterir.
    Fotoğraf <img src="/EvcilHayvan/Fotograf/{id}"> ile YETKİ KONTROLLÜ action'dan gelir (wwwroot'tan değil).
*@
@model EvcilHayvan
@{
    var simge = Model.Tur switch { "Kedi" => "🐱", "Köpek" => "🐶", "Kuş" => "🐦", "Tavşan" => "🐰", "Hamster" => "🐹", "Sürüngen" => "🦎", _ => "🐾" };
    var yas = DateTime.Today.Year - Model.DogumTarihi.Year - (DateOnly.FromDateTime(DateTime.Today) < Model.DogumTarihi.AddYears(DateTime.Today.Year - Model.DogumTarihi.Year) ? 1 : 0);
}
<div class="card kart-golge h-100 hayvan-kart">
    @if (Model.FotografDosyaAdi is not null)
    {
        <img src="@Url.Action("Fotograf", "EvcilHayvan", new { area = "", id = Model.Id })" alt="@Model.Ad fotoğrafı" loading="lazy" />
    }
    else
    {
        <div class="hayvan-foto-yok" aria-hidden="true">@simge</div>
    }
    <div class="card-body">
        <h2 class="h5 mb-1">@Model.Ad</h2>
        <p class="text-muted mb-2">@Model.Tur@(Model.Irk is null ? "" : " · " + Model.Irk) · @yas yaş@(Model.Kilo is null ? "" : $" · {Model.Kilo:0.##} kg")</p>
        @if (!User.IsInRole(Roller.Uye) && Model.Sahip is not null)
        {
            <p class="small mb-2">Sahibi: @Model.Sahip.AdSoyad</p>
        }
        <a asp-area="" asp-controller="EvcilHayvan" asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Detay ve aşılar →</a>
    </div>
</div>
