@*
    PARTIAL VIEW — randevu listesi tablosu. Admin, Hekim ve Üye sayfaları aynı tabloyu kullanır.
    "Detay" bağlantısı hangi alanda (area) olunduğuna göre o alanın Detay action'ına gider
    (asp-action tek başına verilince mevcut area/controller korunur).
    Dar ekranda satırlar alt alta bloklara dönüşür (.yigin-tablo, site.css §9).
    Satırın tamamı tıklanır (stretched-link), "Detay" bağlantısı yine erişilebilir metin olarak durur.
*@
@model List<Randevu>

@if (Model.Count == 0)
{
    <div class="bos-durum">
        <h2>Gösterilecek randevu yok</h2>
        <p>Filtreyi değiştirmeyi ya da başka bir günü seçmeyi deneyin.</p>
    </div>
}
else
{
    <div class="panel p-0">
        <table class="table mb-0 align-middle yigin-tablo randevu-tablosu">
            <thead>
                <tr><th>Tarih ve saat</th><th>Hayvan</th><th>Hizmet</th><th>Hekim</th><th class="text-end">Ücret</th><th>Durum</th><th><span class="visually-hidden">Detay</span></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="yigin-baslik text-nowrap"><span class="veri">@r.BaslangicZamani.ToString("dd.MM.yyyy")</span> <strong class="veri">@r.BaslangicZamani.ToString("HH:mm")</strong><span class="text-body-secondary veri">–@r.BitisZamani.ToString("HH:mm")</span></td>
                        <td data-etiket="Hayvan">@r.EvcilHayvan?.Ad <small class="text-body-secondary">@r.EvcilHayvan?.Tur</small></td>
                        <td data-etiket="Hizmet">@r.Hizmet?.Ad <small class="text-body-secondary">@r.SureDakika dk</small></td>
                        <td data-etiket="Hekim">@r.Veteriner?.AdSoyad</td>
                        <td data-etiket="Ücret" class="text-end text-nowrap veri">@r.Ucret.ToString("N0", new System.Globalization.CultureInfo("tr-TR")) TL</td>
                        <td data-etiket="Durum"><partial name="_DurumRozeti" model="r.Durum" /></td>
                        <td class="text-end yigin-eylem"><a asp-action="Detay" asp-route-id="@r.Id" class="stretched-link satir-baglanti">Detay</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
