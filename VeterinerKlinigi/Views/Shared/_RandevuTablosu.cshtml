@*
    PARTIAL VIEW — randevu listesi tablosu. Admin, Hekim ve Üye sayfaları aynı tabloyu kullanır.
    "Detay" bağlantısı hangi alanda (area) olunduğuna göre o alanın Detay action'ına gider
    (asp-action tek başına verilince mevcut area/controller korunur).
*@
@model List<Randevu>

@if (Model.Count == 0)
{
    <p class="text-muted fst-italic">Gösterilecek randevu yok.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover kart-golge align-middle">
            <thead>
                <tr><th>#</th><th>Tarih / Saat</th><th>Hayvan</th><th>Hizmet</th><th>Hekim</th><th>Ücret</th><th>Durum</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td class="text-nowrap">@r.BaslangicZamani.ToString("dd.MM.yyyy") <strong>@r.BaslangicZamani.ToString("HH:mm")</strong>–@r.BitisZamani.ToString("HH:mm")</td>
                        <td>@r.EvcilHayvan?.Ad <small class="text-muted">(@r.EvcilHayvan?.Tur)</small></td>
                        <td>@r.Hizmet?.Ad <small class="text-muted">@r.SureDakika dk</small></td>
                        <td>@r.Veteriner?.AdSoyad</td>
                        <td class="text-nowrap">@r.Ucret.ToString("N2") TL</td>
                        <td><partial name="_DurumRozeti" model="r.Durum" /></td>
                        <td><a asp-action="Detay" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Detay</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
