@*
    Beklenmeyen hata sayfası (Program.cs → UseExceptionHandler("/Home/Error"); yalnızca Production'da).
    Ayrıntı kullanıcıya GÖSTERİLMEZ (güvenlik); yalnızca sunucu günlüğünde eşleştirmek için istek numarası.
*@
@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="durum-sayfasi">
    <p class="durum-kodu veri">500</p>
    <h1>Beklenmeyen bir hata oluştu</h1>
    <p>İşleminiz tamamlanamadı. Biraz sonra tekrar deneyin.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary">İstek numarası: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="AnaSayfa">Ana sayfaya dön</a>
</div>
