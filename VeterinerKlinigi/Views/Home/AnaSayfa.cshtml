@*
    ANA SAYFA = KİŞİSEL ÖZET (25.11)
    - Giriş gerekir ([Authorize]). Rol kime aitse o özet çizilir:
        Üye   → Views/Home/_UyeOzeti.cshtml
        Hekim → Views/Home/_HekimOzeti.cshtml
        Admin → Views/Home/_AdminOzeti.cshtml
    - Liste sayfalarının (Hizmetler, Hekimlerimiz, Hayvanlarım, Randevularım) tekrarı DEĞİL:
      "şu an benim için ne önemli?" sorusunun cevabı. Veri: OzetServisi (HomeController.AnaSayfa).
    - Üst kısım herkes için aynı: saate göre selamlama + kliniğin şu anki durumu (açık/kapalı).
    - ANİMASYON: açılışta başlık maskeden yükselir, kartlar sırayla gelir (site.css §8 ve §10).
      "Hareketi azalt" açıksa hiçbiri çalışmaz.
    - Betikler aşağıdaki Scripts bölümünde (partial view'lar kendi Scripts bölümünü tanımlayamaz).
*@
@model AnaSayfaVM

<div class="ozet-ust acilis">
    <h1 class="ozet-selam"><span class="satir"><span>@Model.Selam</span></span></h1>
    <p class="klinik-durumu acilis-sonra">
        <span class="durum-noktasi @(Model.KlinikAcik ? "acik" : "kapali")" aria-hidden="true"></span>@Model.KlinikDurumu
    </p>
</div>

@if (Model.Uye is not null)
{
    <partial name="_UyeOzeti" model="Model" />
}
else if (Model.Hekim is not null)
{
    <partial name="_HekimOzeti" model="Model" />
}
else if (Model.Admin is not null)
{
    <partial name="_AdminOzeti" model="Model" />
}
else
{
    @* Hekim rolü var ama hekim kaydı yoksa (admin henüz eşleştirmediyse) *@
    <div class="bos-durum">
        <h2>Hesabınız bir hekim kaydına bağlı değil</h2>
        <p>Yöneticiden hesabınızı hekim kaydıyla eşleştirmesini isteyin.</p>
    </div>
}

@section Scripts {
    <script>
        // ------------------------------------------------------------------
        // GERİ SAYIM: data-geri-sayim="2026-12-07T10:00" olan öğeye "3 gün 4 saat" yazar, dakikada bir yeniler.
        // İlk değeri sunucu yazar (JS kapalıysa da doğru görünür); bu betik sayfa açık kaldıkça günceller.
        // ------------------------------------------------------------------
        function kalanYaz(ms) {
            if (ms <= 0) return 'şimdi';
            var dk = Math.floor(ms / 60000), gun = Math.floor(dk / 1440), saat = Math.floor((dk % 1440) / 60), dakika = dk % 60;
            if (gun > 0) return gun + ' gün ' + saat + ' saat';
            if (saat > 0) return saat + ' saat ' + dakika + ' dk';
            return dakika + ' dk';
        }
        function sayaclariGuncelle() {
            $('[data-geri-sayim]').each(function () {
                $(this).text(kalanYaz(new Date($(this).data('geri-sayim')) - new Date()));
            });
        }
        sayaclariGuncelle();
        setInterval(sayaclariGuncelle, 60000);
    </script>

    @if (Model.Uye is not null)
    {
        <script>
            // ------------------------------------------------------------------
            // ÖDEV 5.1 — HIZLI RANDEVU: REST API tüketimi.
            // Hizmet (select) ve gün (çip) seçildikçe GET /api/veterinerler/uygun?hizmetId=..&tarih=.. çağrılır;
            // cevap [{ veterinerId, adSoyad, uzmanliklar, bosSaatler: ["09:00", ...] }] çiplere dönüşür.
            // Bir saate tıklamak randevu formunu o hizmet, gün, hekim ve saat SEÇİLİ olarak açar.
            // Kural sunucuda (MusaitlikServisi); burada sadece gösteriyoruz.
            // ------------------------------------------------------------------
            (function () {
                var kart = $('#hizliRandevu');
                if (kart.length === 0) return;
                var govde = $('#hizliGovde');
                var formAdresi = '@Url.Action("Olustur", "Randevu")';
                function guvenli(m) { return $('<div>').text(m ?? '').html(); }   // XSS'e karşı metni kaçır

                function yukle() {
                    var hizmetId = $('#hizliHizmet').val();
                    var tarih = kart.find('.gun-cipi[aria-pressed=true]').data('tarih');
                    if (!hizmetId || !tarih) return;
                    govde.attr('aria-busy', 'true').addClass('yukleniyor');

                    $.getJSON('/api/veterinerler/uygun', { hizmetId: hizmetId, tarih: tarih })
                        .done(function (hekimler) {
                            govde.empty();
                            var dolu = hekimler.filter(function (h) { return h.bosSaatler.length > 0; });
                            if (dolu.length === 0) {
                                govde.append('<p class="fis-bos mb-0">Bu gün bu hizmet için boş saat yok. Başka bir gün seçin.</p>');
                                return;
                            }
                            var sira = 0;                              // çiplerin belirme sırası (CSS --i)
                            $.each(dolu, function (_, h) {
                                var ilk = h.bosSaatler.slice(0, 6);
                                var kalan = h.bosSaatler.length - ilk.length;
                                var cipler = $.map(ilk, function (s) {
                                    var adres = formAdresi + '?' + $.param({ hizmetId: hizmetId, tarih: tarih, veterinerId: h.veterinerId, saat: s });
                                    return '<a class="saat-cipi yeni" style="--i:' + (sira++) + '" href="' + adres + '" aria-label="' +
                                        guvenli(h.adSoyad) + ', ' + s + '">' + s + '</a>';
                                }).join('');
                                if (kalan > 0) cipler += '<span class="saat-cipi-fazla">+' + kalan + ' saat daha</span>';
                                govde.append(
                                    '<div class="fis-satir">' +
                                        '<div class="fis-hekim"><strong>' + guvenli(h.adSoyad) + '</strong><span>' + guvenli(h.uzmanliklar.join(', ')) + '</span></div>' +
                                        '<div class="saat-cipleri">' + cipler + '</div>' +
                                    '</div>');
                            });
                        })
                        .fail(function () {
                            govde.html('<p class="fis-bos mb-0">Boş saatler şu an alınamadı. Randevu formundan deneyin.</p>');
                        })
                        .always(function () { govde.attr('aria-busy', 'false').removeClass('yukleniyor'); });
                }

                $('#hizliHizmet').on('change', yukle);
                kart.on('click', '.gun-cipi', function () {
                    kart.find('.gun-cipi').attr('aria-pressed', 'false');
                    $(this).attr('aria-pressed', 'true');
                    yukle();
                });
                yukle();
            })();
        </script>
    }

    @if (Model.Hekim is not null)
    {
        <script>
            // ------------------------------------------------------------------
            // HEKİM ÇİZELGESİ: "şu an" çizgisi. Çizelge açılıştan kapanışa 0–100% yükseklik;
            // çizginin yeri = (şimdi − açılış) / (kapanış − açılış). Dakikada bir yenilenir.
            // Açılış/kapanış dışındaysa çizgi gizlenir. Geçmiş randevular "gecti" sınıfıyla soluklaşır.
            // ------------------------------------------------------------------
            (function () {
                var cizelge = $('#gunCizelgesi');
                if (cizelge.length === 0) return;
                var acilis = cizelge.data('acilis'), kapanis = cizelge.data('kapanis');   // gün içindeki dakika
                function guncelle() {
                    var t = new Date(), dk = t.getHours() * 60 + t.getMinutes();
                    var oran = (dk - acilis) / (kapanis - acilis);
                    $('#suAnCizgisi').toggle(oran >= 0 && oran <= 1).css('top', (oran * 100) + '%')
                        .find('time').text(('0' + t.getHours()).slice(-2) + ':' + ('0' + t.getMinutes()).slice(-2));
                    cizelge.find('.cizelge-randevu').each(function () {
                        $(this).toggleClass('gecti', $(this).data('bitis') <= dk);
                    });
                }
                guncelle();
                setInterval(guncelle, 60000);
            })();
        </script>
    }
}
