@*
    Evcil hayvan detayı.
    - Üst kısım: fotoğraf, ad, tür ve ölçüler — controller'dan (Model)
    - ÖDEV 3.3 / 5.2 — "Aşı takvimi" zaman çizelgesi: jQuery → GET /api/evcil-hayvanlar/{id}/asilar (REST API tüketimi).
      API iki liste döner: gecmis (yapılan dozlar) ve yaklasan (sonraki doz tarihi bugün veya sonrası).
      İkisi tek bir tarih sırasına dizilir, araya "Bugün" çizgisi konur.
    - Aşı kayıtları tablosu (düzenle / sil bağlantılarıyla): Model.AsiKayitlari
    - Randevu geçmişi: Model.Randevular
*@
@model EvcilHayvan
@{
    var kb = User.Bilgi();
    var sahibiMi = kb.AdminMi || Model.SahipId == kb.Id;
    var TurkceKultur = new System.Globalization.CultureInfo("tr-TR");   // 4,2 kg (virgüllü)
    var bugun = DateOnly.FromDateTime(DateTime.Today);
    var yil = bugun.Year - Model.DogumTarihi.Year - (bugun < Model.DogumTarihi.AddYears(bugun.Year - Model.DogumTarihi.Year) ? 1 : 0);
    var ay = (bugun.Year - Model.DogumTarihi.Year) * 12 + bugun.Month - Model.DogumTarihi.Month - (bugun.Day < Model.DogumTarihi.Day ? 1 : 0);
    var yasYazi = yil >= 1 ? $"{yil} yaş" : $"{Math.Max(ay, 0)} aylık";
}

<a asp-action="Index" class="geri-baglanti">Hayvanlarım</a>

@* ---- Üst kısım: kimlik ---- *@
<section class="hayvan-ust">
    <div class="hayvan-gorsel buyuk">
        @if (Model.FotografDosyaAdi is not null)
        {
            <img src="@Url.Action("Fotograf", "EvcilHayvan", new { id = Model.Id })" alt="@Model.Ad fotoğrafı" />
        }
        else
        {
            <span class="hayvan-harf" aria-hidden="true">@Model.Ad[..1]</span>
        }
    </div>
    <div class="hayvan-kimlik">
        <h1>@Model.Ad</h1>
        <p class="hayvan-tur">@Model.Tur@(Model.Irk is null ? "" : ", " + Model.Irk)</p>
        <dl class="hayvan-olcu">
            <div><dt>Yaş</dt><dd>@yasYazi</dd></div>
            <div><dt>Doğum</dt><dd>@Model.DogumTarihi.ToString("dd.MM.yyyy")</dd></div>
            <div><dt>Kilo</dt><dd>@(Model.Kilo is null ? "—" : Model.Kilo.Value.ToString("0.##", TurkceKultur) + " kg")</dd></div>
            <div><dt>Sahibi</dt><dd class="duz">@Model.Sahip?.AdSoyad</dd></div>
        </dl>
    </div>
    <div class="hayvan-eylem">
        @if (User.IsInRole(Roller.Uye) && Model.SahipId == kb.Id)
        {
            <a asp-controller="Randevu" asp-action="Olustur" asp-route-hayvanId="@Model.Id" class="btn btn-primary">Randevu al</a>
        }
        @if (sahibiMi)
        {
            <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-koyu">Düzenle</a>
            <a asp-action="Sil" asp-route-id="@Model.Id" class="btn btn-outline-danger">Sil</a>
        }
    </div>
</section>

<div class="row g-4 g-lg-5">
    <div class="col-lg-7">
        @* ---- REST API'den gelen aşı takvimi ---- *@
        <section class="panel">
            <div class="panel-baslik">
                <h2>Aşı takvimi</h2>
                <a asp-controller="AsiKaydi" asp-action="Ekle" asp-route-hayvanId="@Model.Id" class="btn btn-sm btn-primary">Aşı ekle</a>
            </div>
            <ol id="asiCizelgesi" class="asi-cizelgesi" aria-live="polite">
                <li class="cizelge-bilgi">Yükleniyor…</li>
            </ol>
            <p class="panel-not">Kaynak: <code>GET /api/evcil-hayvanlar/@Model.Id/asilar</code></p>
        </section>

        @* ---- Aşı kayıtları (düzenle / sil) ---- *@
        <section class="panel">
            <div class="panel-baslik"><h2>Aşı kayıtları</h2></div>
            @* Dar ekranda tablo satırları alt alta "kart satır"a dönüşür (site.css → .yigin-tablo); yatay kaydırma olmaz *@
            <div>
                <table class="table mb-0 align-middle yigin-tablo">
                    <thead><tr><th>Aşı</th><th>Yapıldığı</th><th>Sonraki doz</th><th>Not</th><th><span class="visually-hidden">İşlemler</span></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.AsiKayitlari)
                        {
                            <tr>
                                <td class="yigin-baslik">@a.AsiAdi</td>
                                <td class="veri" data-etiket="Yapıldığı">@a.YapildigiTarih.ToString("dd.MM.yyyy")</td>
                                <td class="veri" data-etiket="Sonraki doz">@(a.SonrakiDozTarihi?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="small text-body-secondary" data-etiket="Not">@a.Notlar</td>
                                <td class="text-end text-nowrap yigin-eylem">
                                    <a asp-controller="AsiKaydi" asp-action="Duzenle" asp-route-id="@a.Id" class="btn btn-sm btn-koyu">Düzenle</a>
                                    <form asp-controller="AsiKaydi" asp-action="Sil" asp-route-id="@a.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('@a.AsiAdi kaydı silinsin mi?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (Model.AsiKayitlari.Count == 0)
                        {
                            <tr><td colspan="5" class="text-body-secondary yigin-baslik">Aşı kaydı yok. "Aşı ekle" ile ilk kaydı girin.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-lg-5">
        @* ---- Randevu geçmişi ---- *@
        <section class="panel">
            <div class="panel-baslik"><h2>Randevular</h2></div>
            @if (Model.Randevular.Count == 0)
            {
                <p class="text-body-secondary mb-0">Bu hayvan için randevu yok.</p>
            }
            else
            {
                <ul class="randevu-satirlari">
                    @foreach (var r in Model.Randevular)
                    {
                        <li>
                            <time class="veri" datetime="@r.BaslangicZamani.ToString("yyyy-MM-ddTHH:mm")">@r.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</time>
                            <span class="randevu-ne">@r.Hizmet?.Ad<small>@r.Veteriner?.AdSoyad</small></span>
                            <partial name="_DurumRozeti" model="r.Durum" />
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        function guvenli(m) { return $('<div>').text(m ?? '').html(); }
        function tarihYaz(iso) { return new Date(iso + 'T00:00:00').toLocaleDateString('tr-TR'); }

        // REST API → AsiTakvimiDto { gecmis: [...], yaklasan: [...] }
        $.getJSON('/api/evcil-hayvanlar/@Model.Id/asilar')
            .done(function (takvim) {
                // Tek zaman çizelgesi: yapılan dozlar (yapildigiTarih) + planlı dozlar (sonrakiDozTarihi)
                var olaylar = [];
                $.each(takvim.gecmis, function (_, a) {
                    olaylar.push({ tarih: a.yapildigiTarih, ad: a.asiAdi, planli: false });
                });
                $.each(takvim.yaklasan, function (_, a) {
                    olaylar.push({ tarih: a.sonrakiDozTarihi, ad: a.asiAdi, planli: true, kalan: a.kalanGun });
                });
                // ISO tarih (yyyy-MM-dd) metin olarak da doğru sıralanır
                olaylar.sort(function (x, y) { return x.tarih < y.tarih ? -1 : x.tarih > y.tarih ? 1 : 0; });

                var liste = $('#asiCizelgesi').empty();
                if (olaylar.length === 0) {
                    liste.append('<li class="cizelge-bilgi">Henüz aşı kaydı yok.</li>');
                    return;
                }

                var bugunEklendi = false;
                $.each(olaylar, function (_, o) {
                    // İlk planlı dozdan hemen önce "Bugün" çizgisi
                    if (o.planli && !bugunEklendi) {
                        liste.append('<li class="cizelge-bugun"><span>Bugün</span></li>');
                        bugunEklendi = true;
                    }
                    var sinif = o.planli ? (o.kalan <= 30 ? 'planli yakin' : 'planli') : 'yapildi';
                    var sag = o.planli
                        ? (o.kalan === 0 ? 'bugün' : o.kalan + ' gün sonra')
                        : 'yapıldı';
                    liste.append(
                        '<li class="cizelge-olay ' + sinif + '">' +
                            '<time class="veri">' + tarihYaz(o.tarih) + '</time>' +
                            '<span class="olay-ad">' + guvenli(o.ad) + '</span>' +
                            '<span class="olay-durum">' + sag + '</span>' +
                        '</li>');
                });
                if (!bugunEklendi) {
                    liste.append('<li class="cizelge-bugun"><span>Bugün</span></li>');
                    liste.append('<li class="cizelge-bilgi">Planlı aşı yok.</li>');
                }
            })
            .fail(function (xhr) {
                $('#asiCizelgesi').html('<li class="cizelge-bilgi text-danger">Aşı takvimi alınamadı (HTTP ' + xhr.status + ').</li>');
            });
    </script>
}
