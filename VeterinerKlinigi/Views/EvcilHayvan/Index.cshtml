@* ÖDEV 3.1 — Sahibin birden fazla hayvanı. Admin hepsini, hekim kendi hastalarını görür. *@
@model List<EvcilHayvan>

<div class="sayfa-basi">
    <div>
        <h1>@ViewData["Title"]</h1>
        @if (Model.Count > 0)
        {
            <p class="sayfa-alt">@Model.Count kayıtlı hayvan</p>
        }
    </div>
    @if (User.IsInRole(Roller.Uye))
    {
        <a asp-action="Ekle" class="btn btn-primary">Yeni hayvan ekle</a>
    }
</div>

@if (Model.Count == 0)
{
    @* Boş durum: ne yapılacağını söyler *@
    <div class="bos-durum">
        @if (User.IsInRole(Roller.Uye))
        {
            <h2>Henüz hayvan eklemediniz</h2>
            <p>Randevu almak ve aşı takvimini takip etmek için önce hayvanınızı ekleyin.</p>
            <a asp-action="Ekle" class="btn btn-primary">Yeni hayvan ekle</a>
        }
        else
        {
            <h2>Kayıtlı hayvan yok</h2>
        }
    </div>
}

<div class="hayvan-izgara">
    @foreach (var h in Model)
    {
        <partial name="_HayvanKarti" model="h" />
    }
</div>
