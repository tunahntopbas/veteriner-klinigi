@* ÖDEV 3.1 — Sahibin birden fazla hayvanı. Admin hepsini, hekim kendi hastalarını görür. *@
@model List<EvcilHayvan>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    @if (User.IsInRole(Roller.Uye))
    {
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni hayvan</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Henüz kayıtlı hayvan yok.</div>
}

<div class="row g-3">
    @foreach (var h in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <partial name="_HayvanKarti" model="h" />
        </div>
    }
</div>
