@*
    ÖDEV Beklenen-AdminPaneli — özet sayılar, önümüzdeki 7 günün doluluğu ve yönetim kısayolları.
    Ana sayfadaki admin özetiyle aynı partial (Views/Home/_AdminOzeti.cshtml) ve aynı servis (OzetServisi).
*@
@model AnaSayfaVM

<div class="sayfa-basi">
    <div>
        <h1>Yönetim paneli</h1>
        <p class="sayfa-alt">@ViewData["HayvanSayisi"] kayıtlı hayvan, @ViewData["HizmetSayisi"] aktif hizmet</p>
    </div>
</div>

<partial name="~/Views/Home/_AdminOzeti.cshtml" model="Model" />
