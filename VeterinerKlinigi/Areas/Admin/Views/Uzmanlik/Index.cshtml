@* Uzmanlık alanları listesi. Dar ekranda .yigin-tablo ile bloklara dönüşür. *@
@model List<Uzmanlik>

<div class="sayfa-basi">
    <div>
        <h1>Uzmanlık alanları</h1>
        <p class="sayfa-alt">Hekimlere atanır; hekimler sayfasında ve randevu adımlarında görünür.</p>
    </div>
    <a asp-action="Ekle" class="btn btn-primary">Yeni uzmanlık</a>
</div>

<div class="panel p-0">
    <table class="table mb-0 align-middle yigin-tablo randevu-tablosu">
        <thead><tr><th>Uzmanlık</th><th>Hekimler</th><th class="text-end">İşlemler</th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="yigin-baslik">@u.Ad</td>
                    <td data-etiket="Hekimler">@(u.Veterinerler.Count == 0 ? "—" : string.Join(", ", u.Veterinerler.Select(v => v.AdSoyad)))</td>
                    <td class="text-end text-nowrap yigin-eylem">
                        <a asp-action="Duzenle" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        @* Silme POST formuyla; onsubmit ile tarayıcı onay kutusu *@
                        <form asp-action="Sil" asp-route-id="@u.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@u.Ad silinsin mi? Hekimlerden de kaldırılır.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
