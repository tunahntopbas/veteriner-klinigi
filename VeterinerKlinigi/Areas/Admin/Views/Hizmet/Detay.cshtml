@model Hizmet

<h1 class="h3 mb-3">@Model.Ad</h1>
<div class="card kart-golge" style="max-width:640px">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Açıklama</dt><dd class="col-sm-8">@(Model.Aciklama ?? "—")</dd>
            <dt class="col-sm-4">Süre</dt><dd class="col-sm-8">@Model.SureDakika dakika</dd>
            <dt class="col-sm-4">Ücret</dt><dd class="col-sm-8">@Model.Ucret.ToString("N2") TL</dd>
            <dt class="col-sm-4">Durum</dt><dd class="col-sm-8">@(Model.Aktif ? "Aktif" : "Pasif")</dd>
            <dt class="col-sm-4">Veren hekimler</dt>
            <dd class="col-sm-8">@(Model.Veterinerler.Count == 0 ? "—" : string.Join(", ", Model.Veterinerler.Select(v => v.AdSoyad)))</dd>
        </dl>
    </div>
</div>
<p class="mt-3">
    <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
    <a asp-action="Index" class="btn btn-link">← Listeye dön</a>
</p>
