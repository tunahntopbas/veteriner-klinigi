@* ÖDEV 1.2 / Beklenen-CRUD — Hizmet listesi (R). Ekle (C), Düzenle (U), Sil (D) bağlantıları buradan. *@
@model List<Hizmet>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Hizmetler</h1>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni hizmet</a>
</div>

<table class="table table-hover kart-golge bg-white">
    <thead class="table-light">
        <tr><th>Hizmet</th><th>Süre</th><th>Ücret</th><th>Durum</th><th class="text-end">İşlemler</th></tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr class="@(h.Aktif ? "" : "text-muted")">
                <td><a asp-action="Detay" asp-route-id="@h.Id">@h.Ad</a></td>
                <td>@h.SureDakika dk</td>
                <td>@h.Ucret.ToString("N2") TL</td>
                <td>@(h.Aktif ? "Aktif" : "Pasif")</td>
                <td class="text-end">
                    <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Sil" asp-route-id="@h.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
