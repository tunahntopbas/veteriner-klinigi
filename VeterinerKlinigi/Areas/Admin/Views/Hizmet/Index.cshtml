@* ÖDEV 1.2 / Beklenen-CRUD — Hizmet listesi (R). Ekle (C), Düzenle (U), Sil (D) bağlantıları buradan.
   Dar ekranda satırlar alt alta bloklara dönüşür (.yigin-tablo, site.css §9). *@
@model List<Hizmet>

<div class="sayfa-basi">
    <div>
        <h1>Hizmetler</h1>
        <p class="sayfa-alt">Süre ve ücret randevu alınırken kullanılır; pasif hizmet yeni randevuda görünmez.</p>
    </div>
    <a asp-action="Ekle" class="btn btn-primary">Yeni hizmet</a>
</div>

<div class="panel p-0">
    <table class="table mb-0 align-middle yigin-tablo randevu-tablosu">
        <thead>
            <tr><th>Hizmet</th><th>Süre</th><th class="text-end">Ücret</th><th>Durum</th><th class="text-end">İşlemler</th></tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr class="@(h.Aktif ? "" : "text-body-secondary")">
                    <td class="yigin-baslik"><a asp-action="Detay" asp-route-id="@h.Id">@h.Ad</a></td>
                    <td data-etiket="Süre" class="veri">@h.SureDakika dk</td>
                    <td data-etiket="Ücret" class="text-end veri">@h.Ucret.ToString("N2", new System.Globalization.CultureInfo("tr-TR")) TL</td>
                    <td data-etiket="Durum">@(h.Aktif ? "Aktif" : "Pasif")</td>
                    <td class="text-end text-nowrap yigin-eylem">
                        <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Sil" asp-route-id="@h.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
