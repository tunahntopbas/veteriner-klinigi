@*
    ÖDEV 4.4 — Admin onay / red / tamamla / iptal / sil.
    Düğmeler sadece durum makinesinin izin verdiği geçişler için görünür;
    yine de asıl kontrol RandevuServisi.GecisGecerliMi'de (düğme gizlemek güvenlik değildir).
*@
@model Randevu

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Randevu #@Model.Id</h1>
    <a asp-action="Index" class="btn btn-link">← Tüm randevular</a>
</div>

<div class="row g-4">
    <div class="col-lg-7"><partial name="_RandevuBilgileri" model="Model" /></div>
    <div class="col-lg-5">
        <div class="card kart-golge">
            <div class="card-body d-grid gap-2">
                @if (Model.Durum == RandevuDurumu.Bekliyor)
                {
                    <form asp-action="Onayla" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button type="submit" class="btn btn-success">✓ Onayla</button>
                    </form>
                    <form asp-action="Reddet" method="post">
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <textarea name="Neden" class="form-control mb-2" rows="2" maxlength="300" placeholder="Red nedeni (isteğe bağlı)"></textarea>
                        <button type="submit" class="btn btn-outline-danger w-100">✗ Reddet</button>
                    </form>
                }
                @if (Model.Durum == RandevuDurumu.Onaylandi)
                {
                    <form asp-action="Tamamla" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button type="submit" class="btn btn-success">Tamamlandı olarak işaretle</button>
                    </form>
                }
                @if (RandevuServisi.GecisGecerliMi(Model.Durum, RandevuDurumu.IptalEdildi))
                {
                    <form asp-action="Iptal" asp-route-id="@Model.Id" method="post" class="d-grid" onsubmit="return confirm('Randevu iptal edilsin mi?');">
                        <button type="submit" class="btn btn-outline-secondary">İptal et</button>
                    </form>
                }
                <form asp-action="Sil" asp-route-id="@Model.Id" method="post" class="d-grid" onsubmit="return confirm('Randevu KALICI olarak silinsin mi?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Kalıcı olarak sil</button>
                </form>
            </div>
        </div>
    </div>
</div>
