@* ÖDEV 4.3 / 4.4 — Tüm randevular, duruma göre filtre (?durum=Bekliyor). *@
@model List<Randevu>
@{
    var secili = ViewData["Durum"] as RandevuDurumu?;
}

<div class="sayfa-basi">
    <div>
        <h1>Tüm randevular</h1>
        <p class="sayfa-alt">@Model.Count randevu@(secili is null ? "" : ", " + RandevuServisi.DurumAdi(secili.Value).ToLower(new System.Globalization.CultureInfo("tr-TR")))</p>
    </div>
</div>

<partial name="_DurumFiltresi" model="(secili, (string?)null, false)" />

<partial name="_RandevuTablosu" model="Model" />
