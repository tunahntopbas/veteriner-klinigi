@* ÖDEV 2.1 / 2.2 / Beklenen-CRUD — Hekim listesi. Dar ekranda .yigin-tablo ile bloklara dönüşür. *@
@model List<Veteriner>

<div class="sayfa-basi">
    <div>
        <h1>Veteriner hekimler</h1>
        <p class="sayfa-alt">Uzmanlık ve hizmet eşleşmesi, randevuda hangi hekimin seçilebileceğini belirler.</p>
    </div>
    <a asp-action="Ekle" class="btn btn-primary">Yeni hekim</a>
</div>

<div class="panel p-0">
    <table class="table mb-0 align-middle yigin-tablo randevu-tablosu">
        <thead>
            <tr><th>Hekim</th><th>Uzmanlık</th><th>Hizmetler</th><th>Giriş e-postası</th><th>Durum</th><th class="text-end">İşlemler</th></tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr class="@(v.Aktif ? "" : "text-body-secondary")">
                    <td class="yigin-baslik"><a asp-action="Detay" asp-route-id="@v.Id">@v.Unvan @v.AdSoyad</a></td>
                    <td data-etiket="Uzmanlık">@string.Join(", ", v.Uzmanliklar.Select(u => u.Ad))</td>
                    <td data-etiket="Hizmetler" class="small">@string.Join(", ", v.Hizmetler.Select(h => h.Ad))</td>
                    <td data-etiket="Giriş e-postası" class="small yigin-genis">@v.Kullanici?.Email</td>
                    <td data-etiket="Durum">@(v.Aktif ? "Aktif" : "Pasif")</td>
                    <td class="text-end text-nowrap yigin-eylem">
                        <a asp-action="Detay" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Müsaitlik</a>
                        <a asp-action="Duzenle" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Sil" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
