@* ÖDEV 2.1 / 2.2 / Beklenen-CRUD — Hekim listesi. *@
@model List<Veteriner>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Veteriner Hekimler</h1>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni hekim</a>
</div>

<table class="table table-hover kart-golge align-middle">
    <thead>
        <tr><th>Hekim</th><th>Uzmanlık</th><th>Hizmetler</th><th>Giriş e-postası</th><th>Durum</th><th class="text-end">İşlemler</th></tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr class="@(v.Aktif ? "" : "text-muted")">
                <td><a asp-action="Detay" asp-route-id="@v.Id">@v.Unvan @v.AdSoyad</a></td>
                <td>@string.Join(", ", v.Uzmanliklar.Select(u => u.Ad))</td>
                <td class="small">@string.Join(", ", v.Hizmetler.Select(h => h.Ad))</td>
                <td class="small">@v.Kullanici?.Email</td>
                <td>@(v.Aktif ? "Aktif" : "Pasif")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Detay" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Müsaitlik</a>
                    <a asp-action="Duzenle" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Sil" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
