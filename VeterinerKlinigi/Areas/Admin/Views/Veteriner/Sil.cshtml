@model Veteriner

<h1 class="h3 mb-3">Hekimi sil</h1>
<div class="alert alert-warning">
    <strong>@Model.AdSoyad</strong> ve giriş hesabı (@Model.Kullanici?.Email) silinecek. Emin misiniz?
    <br /><small>Randevu geçmişi olan hekim silinemez; düzenleyip "Pasif" yapın.</small>
</div>
<form asp-action="Sil" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
</form>
